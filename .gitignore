/.idea/
__pycache__/
*.py[cod]

# 运行时数据（会话、配置、MCP 配置、记忆）
/data/

# 模型权重（体积大，不入库）
/models/

# 工作区属于本地数据；工作区 README 保留作说明
/workspace/*
!/workspace/README.md

# 技能库：SKILL.md 是项目内容需入库，只忽略运行时标记
/skills/.seeded

# 测试与截图产物
/.shots/
/.tmp/

# Agent 会话记忆（本地数据）
/.workbuddy/

# 调度器运行时目录（空目录，无需入库）
/schedules/*

.venv/
*.log

# 系统/编辑器杂项
.DS_Store
Thumbs.db
*.swp
